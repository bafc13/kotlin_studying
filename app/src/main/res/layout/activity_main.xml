<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_light"
        android:textSize="16sp"
        android:text="@string/initial_data_string"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/initial_list"
        android:layout_width="265dp"
        android:layout_height="48dp"
        android:hint="@string/hint"
        android:inputType="text"
        android:textSize="14sp"
        tools:text="1,2,3,4,5,6,7,7,20,14,23,4,56"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textView"
        app:layout_constraintTop_toTopOf="@+id/textView"
        app:flow_wrapMode="aligned"
        android:background="#f2fafa"/>

    <android.widget.Button
        android:id="@+id/normalize_button"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:text="@string/button_text"
        android:textColor="@color/black"
        android:textAllCaps="false"
        android:background="@drawable/shape_button_normalize"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="@id/textView"
        app:layout_constraintEnd_toEndOf="@id/textView"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_light"
        android:textSize="16sp"
        android:text="@string/normalized_data_string"
        android:layout_marginStart="0dp"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toBottomOf="@id/normalize_button"
        app:layout_constraintStart_toStartOf="@id/textView"/>

    <TextView
        android:id="@+id/normalized_list"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_light"
        android:textSize="16sp"
        android:layout_marginStart="5dp"
        tools:text="1,2,3,4,5,6,7,7,20,14,23,4,56"
        app:layout_constraintStart_toEndOf="@id/textView2"
        app:layout_constraintTop_toTopOf="@id/textView2"
        app:layout_constraintBottom_toBottomOf="@id/textView2"
        android:background="#f2fafa"/>

</androidx.constraintlayout.widget.ConstraintLayout>